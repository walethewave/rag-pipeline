# Copy this file to .env and fill in real values. Never commit the real .env file.

# AWS credentials used to call Claude through Bedrock, and to read/write AWS S3 Vectors (ai.py, storage.py)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
# Bedrock model id for Claude Haiku 4.5. Check the Bedrock console for the exact id in your region.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Embedding model used for turning chunk text into vectors (ai.py).
# Amazon Titan Text v2 produces 512-dim normalized vectors via AWS Bedrock.
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=512

# The S3 Vectors bucket vectors are stored in - one S3 Vectors index per app `index` name, all
# inside this one bucket (storage.py). The bucket must already exist; indexes inside it are
# created on first use. If an index already exists with a different dimension than
# EMBEDDING_DIMENSION, storage.py recreates it automatically (and logs a warning).
S3VECTORS_BUCKET=vestai-faq-vectors

# Where the document registry JSON file is written. This is local even in production - it is NOT
# chunk metadata, just a small list of "which files are in which index" for listing/deleting.
DOCUMENT_REGISTRY_PATH=./data/documents.json

# Default index name used when the caller does not name one
DEFAULT_INDEX=faq

# Max tokens per chunk (pipeline.py). Overlap is always 10% of this, computed automatically.
MAX_CHUNK_TOKENS=500

# Retrieval settings (main.py). 0.18 calibrated empirically against real Titan-embedded data:
# unrelated queries topped out at 0.150, the weakest genuine match (a terse 2-word query) still
# scored 0.229 for its correct chunk - see config.py for the full note. A different embedding
# model would need this recalibrated the same way.
SCORE_THRESHOLD=0.18
EXACT_MATCH_THRESHOLD=0.85

# Upload limits (main.py)
MAX_UPLOAD_MB=20

LOG_LEVEL=INFO
